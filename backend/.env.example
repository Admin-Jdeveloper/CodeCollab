# PostgreSQL Connection (Session or Transaction pooler)
DATABASE_URL="postgresql://user:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Redis Connection (Supports rediss:// for cloud Redis / Render / Upstash)
REDIS_URL="redis://default:password@your-redis-host:6379"

# Or standalone Redis parameters:
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""


# Port (dynamically assigned by Render in production)
PORT=3000
SOCKET_PORT=3001

# Allowed Origins for CORS (* or comma-separated list of origins)
CORS_ORIGIN="*"

# Optional Execution Limits (Worker)
WORKER_CONCURRENCY=3
MAX_COMPILE_TIME_MS=20000
MAX_EXECUTION_TIME_MS=20000
