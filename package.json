{
  "name": "codecollab-monorepo",
  "private": true,
  "scripts": {
    "worker": "bun run backend/execution/worker.ts",
    "daemon": "bun run local-runner/daemon.ts",
    "daemon:deployed": "bun run local-runner/daemon-cloud.ts",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "dev:socket": "cd backend && bun run dev:socket",
    "prisma": "cd backend && bunx --bun prisma",
    "db:generate": "cd backend && bun install && bun run db:generate",
    "db:push": "cd backend && bunx --bun prisma db push",
    "db:migrate": "cd backend && bunx --bun prisma migrate deploy",
    "start": "cd backend && bun run start",
    "start:socket": "cd backend && bun run start:socket",
    "test:execution": "bun run tests/execution.test.ts",
    "test:collaboration": "bun run tests/collaboration.test.ts",
    "test:scaling": "bun run tests/scaling.test.ts",
    "test:multi-socket": "bun run tests/multi-socket.test.ts",
    "test:security": "bun run tests/security.test.ts",
    "test:load": "bun run tests/load.test.ts",
    "test:auth": "bun run tests/auth-reconnection.test.ts",
    "test:rapid": "bun run tests/rapid-typing.test.ts",
    "test:persistence": "bun run tests/out-of-order-persistence.test.ts",
    "test:yjs": "bun run tests/yjs-collaboration.test.ts",
    "test": "bun run test:auth && bun run test:rapid && bun run test:persistence && bun run test:yjs",
    "typecheck": "cd backend && bun run typecheck && cd ../frontend && bun run typecheck",
    "lint": "cd frontend && bun run lint",
    "build": "cd frontend && bun run build"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "yjs": "^13.6.33"
  }
}
